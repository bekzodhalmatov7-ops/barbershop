# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# ── База данных ────────────────────────────────────────
DB_PATH=./data/barbershop.db

# ── Авторизация админа (JWT) ───────────────────────────
JWT_SECRET=change_me_in_production_super_secret_key
JWT_EXPIRES_IN=8h

# ── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Дефолтный админ ────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# ── Telegram-уведомления ───────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CLIENT_NOTIFICATIONS=true
TELEGRAM_RATE_LIMIT_PER_MIN=20
TELEGRAM_DEDUP_WINDOW_SECONDS=30
# ── Группа для подтверждения записей ──────────────────
# chat_id группы админов. Бот должен быть в группе как администратор.
# Узнать: добавьте бота в группу → отправьте /start@ваш_бот → посмотрите свой chat_id
# у @userinfobot (обычно отрицательный, вида -1001234567890).
TELEGRAM_ADMIN_GROUP_ID=

# Требовать подтверждения записей через группу (true/false).
# Если false или группа не задана — заявки сразу становятся confirmed.
TELEGRAM_REQUIRE_CONFIRMATION=true 